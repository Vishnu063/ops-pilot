      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "DeploymentEvent"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1
        },
        "service": {
          "type": "string"
        },
        "release_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "started",
            "succeeded",
            "failed",
            "rollback_started",
            "rollback_succeeded",
            "rollback_failed"
          ]
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "source",
        "timestamp",
        "correlation_id",
        "service",
        "release_id",
        "status"
